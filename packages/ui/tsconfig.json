{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,

    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@operio/ui/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}