{
  "name": "operio-dashboard",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@operio/admin",
    "dev:client": "npm run dev --workspace=@operio/client",
    "build:admin": "npm run build --workspace=@operio/admin",
    "build:client": "npm run build --workspace=@operio/client",
    "lint:admin": "npm run lint --workspace=@operio/admin",
    "lint:client": "npm run lint --workspace=@operio/client",
    "test:admin": "npm run test --workspace=@operio/admin",
    "test:api": "npm run test --workspace=@operio/api"
  }
}
